# Copy to .env to override defaults. Every value is optional for a local run.
# NLIUE_DATA_DIR=./data                 # database, uploaded files and the generated secret key
# NLIUE_SECRET_KEY=                      # set explicitly when running more than one instance
# NLIUE_DEBUG=0
# NLIUE_ALLOWED_HOSTS=localhost,127.0.0.1
# NLIUE_SECURE_COOKIES=1                 # enable once served over HTTPS
# NLIUE_TRUST_FORWARDED_FOR=0            # 1 only when a trusted proxy sets X-Forwarded-For
# NLIUE_LOGIN_MAX_FAILURES=5
# NLIUE_LOGIN_LOCKOUT_SECONDS=900
# NLIUE_SESSION_SECONDS=28800
# NLIUE_ATTACHMENT_MAX_BYTES=26214400
